{
  "manifest_version": 3,
  "name": "Musical",
  "version": "1.0.1",
  "description": "Save video of choice from the side panel",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "sidePanel",
    "nativeMessaging",
    "storage",
    "downloads"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Musical"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["youtube.js"],
      "css": ["youtube.css"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
  }
}
